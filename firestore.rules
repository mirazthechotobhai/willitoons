rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate Character schema
    function isValidCharacter(data) {
      return data != null &&
        data.id is string &&
        data.name is string &&
        data.name.size() > 0 &&
        data.joints is map &&
        data.appearance is map;
    }

    match /characters/{characterId} {
      allow read: if true;
      allow create, update: if isValidCharacter(request.resource.data);
      allow delete: if true;
    }
  }
}
