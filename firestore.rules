rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate Character schema
    function isValidCharacter(data) {
      return data != null &&
        data.id is string &&
        data.name is string &&
        data.name.size() > 0 &&
        data.joints is map &&
        data.appearance is map;
    }

    // Helper function to validate Background schema
    function isValidBackground(data) {
      return data != null &&
        data.id is string &&
        data.name is string &&
        data.url is string;
    }

    // Helper function to validate MediaAsset schema (images, audio, music, video)
    function isValidMediaAsset(data) {
      return data != null &&
        data.id is string &&
        data.name is string &&
        data.type is string &&
        data.url is string;
    }

    // Helper function to validate Animation schema
    function isValidAnimation(data) {
      return data != null &&
        data.id is string &&
        data.serialNumber is number;
    }

    // Helper function to validate Preset schema
    function isValidPreset(data) {
      return data != null &&
        data.id is string &&
        data.name is string;
    }

    match /characters/{characterId} {
      allow read: if true;
      allow create, update: if isValidCharacter(request.resource.data);
      allow delete: if true;
    }

    match /backgrounds/{backgroundId} {
      allow read: if true;
      allow create, update: if isValidBackground(request.resource.data);
      allow delete: if true;
    }

    match /media_assets/{assetId} {
      allow read: if true;
      allow create, update: if isValidMediaAsset(request.resource.data);
      allow delete: if true;
    }

    match /animations/{animationId} {
      allow read: if true;
      allow create, update: if isValidAnimation(request.resource.data);
      allow delete: if true;
    }

    match /character_presets/{presetId} {
      allow read: if true;
      allow create, update: if isValidPreset(request.resource.data);
      allow delete: if true;

      match /frames/{frameId} {
        allow read, write: if true;
      }
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}
